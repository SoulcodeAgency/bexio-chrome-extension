{
  "compilerOptions": {
    /* This package has no build step — it is consumed as TypeScript source by
       the other two packages — so tsc is only ever a type checker here. */
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    /* TypeScript 7 no longer pulls in every `node_modules/@types/*` package
       automatically; this code wraps `chrome.storage.local`. */
    "types": ["chrome"]
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
