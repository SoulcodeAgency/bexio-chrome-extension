{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* TypeScript 7 no longer pulls in every `node_modules/@types/*` package
       automatically, so the ambient globals this code relies on (the `chrome`
       namespace, `process.env` in utils/development.ts) are listed here. */
    "types": ["chrome", "node"],
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* No `baseUrl` — removed in TypeScript 7. Without it these `paths` entries
       resolve relative to this tsconfig.json, which is what we want anyway. */
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "../shared/chromeStorageTemplateEntries.ts"]
}
