{
  "compilerOptions": {
    /* Vite/Rolldown does the emit; tsc is only ever run as a type checker
       (`npm run typecheck`), so it must not write anything into `unpacked/`. */
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    /* Bundler mode — matches how Vite resolves and emits these sources. */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    /* TypeScript 7 no longer pulls in every `node_modules/@types/*` package
       automatically, so the ambient globals this code relies on (the `chrome`
       namespace) have to be listed here. */
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
